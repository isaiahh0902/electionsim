function advance(n){if(W.election){alert('This election has been held. Begin a new cycle from History to continue.');return}let step=W.pace==='week'?.25:W.pace==='quarter'?3:1;for(let i=0;i<n;i++){W.monthIndex=Math.min(0,W.monthIndex+step);if(W.auto&&rand()<W.frequency/100*.85){let side=rand()<.5?'d':'r';let actions=['rally','debate','ad','ground','interview','fundraise','endorsement','negative','gaffe','crisis'];let c=W.candidates[side];let weights=actions.map(a=>a==='gaffe'?Math.max(.15,c.stats['Gaffe proneness']/65):a==='crisis'?.4:1);let total=weights.reduce((a,b)=>a+b,0),x=rand()*total,k=0;while(k<weights.length-1&&x>weights[k])x-=weights[k++];eventFor(side,actions[k])}if(W.autoPoll&&rand()<.35)makePoll(pick(['US','PA','MI','WI','GA','AZ','NV','NC']),pick(['national','civic','atlas','independent']),800,true);if(W.monthIndex===0)break}W.forecast=null;saveUniverse(true);renderAll()}
function performAction(){if(W.election){alert('The election is over.');return}eventFor($('actionSide').value,$('actionType').value,true);saveUniverse(true)}function clearCampaign(){if(!confirm('Clear all campaign events and accumulated campaign effects?'))return;W.campaign={d:0,r:0,fieldD:0,fieldR:0,fundsD:0,fundsR:0,debates:0};W.events=[];W.polls=[];W.forecast=null;W.revision++;saveUniverse(true);renderAll()}
function makePoll(code,pollster,n,silent=false){let st=STATES.find(x=>x[0]===code),margin=code==='US'?nationalMargin():structuralMargin(st),house={national:0,civic:.45,atlas:-.55,independent:.2}[pollster],error=normal()*Math.sqrt(1000/n)*3.3,reported=margin+house+error,other=code==='US'?2.5:thirdShare(st),shares=marginToShares(reported,other);W.polls.unshift({id:id(),date:dateLabel(),code,pollster,n,d:shares[0],r:shares[1],other:shares[2],margin:reported});W.polls=W.polls.slice(0,120);if(!silent){saveUniverse(true);renderAll()}}
function publishPoll(){makePoll($('pollState').value,$('pollster').value,+$('pollSample').value)}
function nationalMargin(){let d=0,r=0;for(let st of STATES){let [ds,rs]=marginToShares(structuralMargin(st),thirdShare(st));d+=ds*st[4];r+=rs*st[4]}return 100*(d-r)/(d+r)}
function simulatedMargins(){let vol=W.volatility/100,shared=normal()*(.9+vol*2.8),regions={};let rows=STATES.map(st=>{let region=st[0]==='PA'||st[0]==='MI'||st[0]==='WI'||st[0]==='OH'||st[0]==='MN'?'midwest':st[0]==='GA'||st[0]==='NC'||st[0]==='FL'||st[0]==='SC'?'southeast':st[0]==='AZ'||st[0]==='NV'||st[0]==='NM'||st[0]==='CO'?'southwest':'other';if(regions[region]===undefined)regions[region]=normal()*(.4+vol*.9);let margin=clamp(structuralMargin(st)+shared+regions[region]+normal()*(.8+vol*3.2),-90,90);return {st,margin}});return rows}
function runForecast(){let n=+$('forecastTrials').value||1000,demWins=0,repWins=0,ties=0,evs=[],stateWin=Object.fromEntries(STATES.map(s=>[s[0],0]));for(let i=0;i<n;i++){let de=0,re=0;for(let {st,margin} of simulatedMargins()){if(margin>0){de+=st[2];stateWin[st[0]]++}else re+=st[2]}evs.push(de);if(de>re)demWins++;else if(re>de)repWins++;else ties++}evs.sort((a,b)=>a-b);W.forecast={n,demWins,repWins,ties,medianD:evs[Math.floor(n/2)],lowD:evs[Math.floor(n*.05)],highD:evs[Math.floor(n*.95)],stateWin,revision:W.revision};saveUniverse(true);renderAll()}
function holdElection(){if(W.election&&!confirm('Replace the existing election results?'))return;let rows=simulatedMargins().map(({st,margin})=>{let third=thirdShare(st),[dp,rp,op]=marginToShares(margin,third),turnout=clamp(W.turnout/100+normal()*.035,.35,.86),total=Math.round(st[4]*turnout),dv=Math.round(total*dp/100),rv=Math.round(total*rp/100),ov=total-dv-rv;return {code:st[0],name:st[1],ev:st[2],margin,dv,rv,ov,total,reported:0}});let houseD=0,houseR=0;for(let i=0;i<435;i++){let st=STATES[i%STATES.length],m=clamp(st[3]+W.env+(quality(W.candidates.d)-quality(W.candidates.r))*.5+normal()*18+(W.campaign.d-W.campaign.r)*.6,-95,95);if(m>0)houseD++;else houseR++}let senateD=0,senateR=0;for(let i=0;i<33;i++){let st=STATES[(i*7+W.year)%STATES.length],m=st[3]+W.env+normal()*12+(W.campaign.d-W.campaign.r)*.7;if(m>0)senateD++;else senateR++}W.election={date:dateLabel(),rows,houseD,houseR,senateD,senateR,created:Date.now()};W.monthIndex=0;event('Election Day','Polls close across the country. Vote counting begins and reported results arrive in batches.');W.history.unshift({year:W.year,date:dateLabel(),result:summarizeElection(W.election),d:W.candidates.d.name,r:W.candidates.r.name});saveUniverse(true);switchTab('results')}
function summarizeElection(e){let d=0,r=0,dv=0,rv=0,ov=0;for(let x of e.rows){if(x.dv>x.rv)d+=x.ev;else r+=x.ev;dv+=x.dv;rv+=x.rv;ov+=x.ov}return {d,r,dv,rv,ov}}
function advanceCount(){if(!W.election){alert('Run election night first.');return}let incomplete=W.election.rows.filter(x=>x.reported<100);if(!incomplete.length){alert('All votes have been counted.');return}let batch=incomplete.sort((a,b)=>a.reported-b.reported).slice(0,Math.max(5,Math.ceil(incomplete.length*.3)));for(let x of batch)x.reported=Math.min(100,x.reported+Math.round(12+rand()*25));saveUniverse(true);renderResults()}function finishCount(){if(!W.election){alert('Run election night first.');return}W.election.rows.forEach(x=>x.reported=100);saveUniverse(true);renderResults()}
