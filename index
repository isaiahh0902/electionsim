function dateLabel(){let d=new Date(W.year,10+W.monthIndex,1);return d.toLocaleString('en-US',{month:'short',year:'numeric'})}function remaining(){return Math.max(0,-W.monthIndex)}function saveUniverse(quiet=false){try{localStorage.setItem('american-electorate-v3',JSON.stringify(W));if(!quiet)alert('Universe saved in this browser.')}catch(e){if(!quiet)alert('Unable to save: '+e.message)}}function download(text,name,type){let blob=new Blob([text],{type}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}function exportUniverse(){download(JSON.stringify(W,null,2),'american-electorate-universe-'+W.year+'.json','application/json')}
$('importFile').onchange=async e=>{let f=e.target.files[0];if(!f)return;try{let v=JSON.parse(await f.text());if(v.version!==3||!v.candidates?.d||!v.candidates?.r)throw Error('Incompatible save version');W=v;saveUniverse(true);renderAll();alert('Universe imported.')}catch(e){alert('Import failed: '+e.message)}e.target.value=''};
function switchTab(tab){document.querySelectorAll('.view').forEach(x=>x.classList.toggle('hide',x.id!==tab));document.querySelectorAll('.nav').forEach(x=>x.classList.toggle('active',x.dataset.tab===tab));let titles={dashboard:'Overview',setup:'Universe settings',candidates:'Candidate studio',campaign:'Campaign headquarters',polling:'Polling & forecasting',results:'Election center',history:'History & records'};$('pageTitle').textContent=titles[tab];$('pageSubtitle').textContent=tab==='results'?'Returns, counting and downballot contests':'The American Electorate · '+dateLabel();if(tab==='polling'&&!W.forecast)runForecast();else renderAll()}document.querySelectorAll('.nav').forEach(b=>b.onclick=()=>switchTab(b.dataset.tab));
function quality(c){let s=c.stats;return .030*(s['Charisma']-50)+.025*(s['Coalition building']-50)+.015*(s['Authenticity']-50)+.014*(s['Trustworthiness']-50)+.014*(s['Organization']-50)+.010*(s['Fundraising']-50)+.009*(s['Media skill']-50)+.008*(s['Discipline']-50)-.013*(s['Gaffe proneness']-50)}
function coalitionFit(c,lean,st){let t=c.coalition;return t==='broad'?.15:t==='working'?(lean<0?.65:.1):t==='suburban'?(Math.abs(lean)<18?.75:-.2):t==='rural'?(lean<0?.8:-.4):t==='urban'?(lean>8?.7:-.4):t==='cross'?(Math.abs(lean)<14?.95:-.2):t==='youth'?(lean>0?.55:.05):t==='base'?(Math.abs(lean)>15?.7:-.3):0}
function structuralMargin(st){let lean=st[3],q=quality(W.candidates.d)-quality(W.candidates.r),fit=coalitionFit(W.candidates.d,lean,st)-coalitionFit(W.candidates.r,lean,st);let econ=(W.economy-50)*.018*(W.env>=0?1:-1);let issue=issueEffects[W.issue];let campaign=W.campaign.d-W.campaign.r;let turnout=(W.turnout-60)*.02;return clamp(lean+W.env+q+fit+econ+issue+campaign+turnout,-90,90)}
function thirdShare(st){return W.third?clamp(2.2+Math.abs(st[3])*.012,1.2,4.8):0}function marginToShares(m,third){let d=clamp((100-third+m)/2,0,100-third);return [d,100-third-d,third]}
function event(title,body,deltaD=0,deltaR=0,kind='neutral'){W.events.unshift({id:id(),date:dateLabel(),title,body,deltaD,deltaR,kind});W.events=W.events.slice(0,250);W.campaign.d=clamp(W.campaign.d+deltaD,-10,10);W.campaign.r=clamp(W.campaign.r+deltaR,-10,10);W.revision++;W.forecast=null}
function eventFor(side,action,manual=false){let c=W.candidates[side],s=c.stats,party=side==='d'?'Democratic':'Republican',success=0,title='',body='',kind='neutral';const skill=(t)=>s[t]||50;switch(action){case 'rally':success=normal()*.22+(skill('Charisma')-50)*.012+(skill('Retail campaigning')-50)*.007;title=party+' rally '+(success>0?'energizes supporters':'falls flat');body=c.name+' holds a large rally. Attendance and local coverage '+(success>0?'exceed':'miss')+' campaign expectations.';break;case 'debate':success=normal()*.28+(skill('Debate skill')-50)*.016+(skill('Coolheadedness')-50)*.006-(skill('Gaffe proneness')-50)*.005;title=c.name+(success>0?' impresses in televised debate':' struggles during debate');body='Debate analysts focus on preparation, composure, and message discipline.';W.campaign.debates++;break;case 'ad':success=normal()*.2+(skill('Fundraising')-50)*.008+(skill('Media skill')-50)*.008;title=party+' campaign launches new advertising';body='A targeted advertising buy shifts attention toward the campaign’s preferred issues.';break;case 'ground':success=normal()*.12+(skill('Organization')-50)*.010+(skill('Coalition building')-50)*.007;title=party+' campaign expands ground game';body='Organizers increase volunteer recruitment and voter contact in competitive areas.';W.campaign[side==='d'?'fieldD':'fieldR']+=Math.max(0,success+.3);break;case 'interview':success=normal()*.35+(skill('Media skill')-50)*.014+(skill('Coolheadedness')-50)*.005-(skill('Gaffe proneness')-50)*.011;title=c.name+(success>=0?' delivers effective interview':' stumbles in interview');body='An unscripted media appearance '+(success>=0?'helps introduce the candidate to persuadable voters.':'generates difficult headlines and renewed scrutiny.');break;case 'fundraise':success=normal()*.13+(skill('Fundraising')-50)*.009;title=party+' fundraising drive '+(success>0?'exceeds expectations':'underperforms');body='Campaign resources '+(success>0?'expand':'remain constrained')+' following 