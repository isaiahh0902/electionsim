ical volatility',W.volatility],['Incumbent approval',W.incumbency]].map(x=>`<div class="rowline"><div class="flex between small"><span>${x[0]}</span><strong>${x[1]}/100</strong></div><div class="progress" style="margin-top:7px"><div style="width:${x[1]}%"></div></div></div>`).join('');renderEvents('dashEvents',4)}
function renderCampaign(){$('campaignClock').textContent=dateLabel();$('campaignRemaining').textContent=W.election?'Election completed':remaining()+' months until election';$('campaignStanding').innerHTML=['d','r'].map(s=>`<div class="rowline"><strong class="${s==='d'?'dem':'rep'}">${esc(W.candidates[s].name)}</strong><div class="small muted">Accumulated campaign margin effect: ${round(W.campaign[s],2)} · Organization investment: ${round(W.campaign[s==='d'?'fieldD':'fieldR'],1)} · Fundraising: ${round(W.campaign[s==='d'?'fundsD':'fundsR'],1)}</div></div>`).join('');renderEvents('campaignTimeline')}
function renderPolling(){let f=W.forecast;if(f){$('forecastPanel').innerHTML=`<div class="grid"><div class="span4"><div class="kicker">Democratic win frequency</div><div class="metric dem">${round(f.demWins/f.n*100,1)}%</div></div><div class="span4"><div class="kicker">Republican win frequency</div><div class="metric rep">${round(f.repWins/f.n*100,1)}%</div></div><div class="span4"><div class="kicker">Median Democratic EV</div><div class="metric">${f.medianD}</div></div></div><div class="bar" style="height:18px;margin:14px 0"><div class="d" style="width:${f.demWins/f.n*100}%"></div><div class="r" style="width:${f.repWins/f.n*100}%"></div></div><div class="muted small">Central 90% of simulated Democratic electoral-vote totals: ${f.lowD}–${f.highD}. Based on ${fmt(f.n)} independent trial outcomes. Recalculate after changing settings or candidate attributes.</div><hr class="hr"><h3>Competitive-state win frequency</h3>${STATES.filter(st=>Math.abs(structuralMargin(st))<14).sort((a,b)=>Math.abs(structuralMargin(a))-Math.abs(structuralMargin(b))).slice(0,12).map(st=>`<div class="rowline flex between"><span>${st[1]}</span><span class="dem">D ${round(f.stateWin[st[0]]/f.n*100,0)}%</span></div>`).join('')}`;}else $('forecastPanel').innerHTML='<div class="empty">Run a forecast to estimate electoral uncertainty.</div>';$('pollList').innerHTML=W.polls.length?`<table><thead><tr><th>Date</th><th>Jurisdiction</th><th>Pollster</th><th>Sample</th><th>Dem</th><th>Rep</th><th>Lead</th></tr></thead><tbody>${W.polls.map(p=>`<tr><td>${esc(p.date)}</td><td>${esc(p.code)}</td><td>${esc(p.pollster)}</td><td>${fmt(p.n)}</td><td class="dem">${round(p.d)}%</td><td class="rep">${round(p.r)}%</td><td>${p.margin>=0?'D':'R'} +${round(Math.abs(p.margin))}</td></tr>`).join('')}</tbody></table>`:'<div class="empty">No polls have been conducted.</div>'}
function renderResults(){let e=W.election;if(!e){$('electionStatus').textContent='No election has been held.';$('electionHeadline').innerHTML='<div class="empty">Run election night to generate results. You can then reveal the count in batches.</div>';$('resultsTable').innerHTML='';$('downballot').innerHTML='<div class="muted">Downballot estimates appear after election night.</div>';return}let s=summarizeElection(e),reported=e.rows.reduce((a,b)=>a+b.reported,0)/e.rows.length;let dPct=100*s.dv/(s.dv+s.rv+s.ov),rPct=100*s.rv/(s.dv+s.rv+s.ov);$('electionStatus').textContent=round(reported,0)+'% of state returns counted on average · '+e.date;$('electionHeadline').innerHTML=`<div class="grid" style="margin-top:15px"><div class="span4"><div class="kicker">Democratic electoral votes</div><div class="metric dem">${s.d}</div><div class="small muted">${esc(W.candidates.d.name)} · ${round(dPct,2)}% popular vote</div></div><div class="span4"><div class="kicker">Republican electoral votes</div><div class="metric rep">${s.r}</div><div class="small muted">${esc(W.candidates.r.name)} · ${round(rPct,2)}% popular vote</div></div><div class="span4"><div class="kicker">Winner after full count</div><div class="metric" style="font-size:21px">${s.d>s.r?'Democratic':s.r>s.d?'Republican':'Electoral tie'}</div><div class="small muted">Projected winner based on underlying simulated vote totals</div></div></div><div class="bar" style="margin-top:14px;height:18px"><div class="d" style="width:${s.d/538*100}%"></div><div class="r" style="width:${s.r/538*100}%"></div></div><p class="hint">The summary shows final simulated totals even when state reporting is incomplete; the table reveals only counted batches. Maine and Nebraska electoral votes are simplified as statewide winner-take-all.</p>`;let sort=$('resultsSort').value,search=$('resultsSearch').value.trim().toLowerCase(),rows=e.rows.filter(x=>x.name.toLowerCase().includes(search)||x.code.toLowerCase().includes(search));rows.sort((a,b)=>sort==='state'?a.name.localeCompare(b.name):sort==='ev'?b.ev-a.ev:sort==='margin'?b.margin-a.margin:Math.abs(a.margin)-Math.abs(b.margin));$('resultsTable').innerHTML=`<table><thead><tr><th>State</th><th>EV</th><th>Reporting</th><th>Democratic votes</th><th>Republican votes</th><th>Other</th><th>Reported lead</th><th>Final margin</th></tr></thead><tbody>${rows.map(x=>{let ratio=x.reported/100,dem=Math.round(x.dv*ratio),rep=Math.round(x.rv*ratio),oth=Math.round(x.ov*ratio),lead=dem-rep;return `<tr><td>${esc(x.name)} <span class="muted">${x.code}</span></td><td>${x.ev}</td><td>${x.reported}%</td><td class="dem">${fmt(dem)}</td><td class="rep">${fmt(rep)}</td><td>${fmt(oth)}</td><td class="${lead>=0?'dem':'rep'}">${x.reported===0?'—':(lead>=0?'D':'R')+' +'+fmt(Math.abs(lead))}</td><td class="${x.margin>=0?'dem':'rep'}">${x.margin>=0?'D':'R'} +${round(Math.abs(x.margin),1)}</td></tr>`}).join('')}</tbody></table>`;$('downballot').innerHTML=`<div class="split"><div class="panel" style="padding:13px"><h3>House model · 435 hypothetical districts</h3><div class="flex between"><strong class="dem">D ${e.houseD}</strong><strong class="rep">R ${e.houseR}</strong></div><div class="bar"><div class="d" style="width:${e.houseD/435*100}%"></div><div class="r" style="width:${e.houseR/435*100}%"></div></div><div class="hint">Synthetic districts, not actual district geography.</div></div><div class="panel" style="padding:13px"><h3>Senate model · 33 illustrative contests</h3><div class="flex between"><strong class="dem">D ${e.senateD}</strong><strong class="rep">R ${e.senateR}</strong></div><div class="bar"><div class="d" style="width:${e.senateD/33*100}%"></div><div class="r" style="width:${e.senateR/33*100}%"></div></div><div class="hint">Not a modeled Senate chamber composition.</div></div></div>`}
function renderHistory(){$('historyList').innerHTML=W.history.length?W.history.map(h=>`<div class="rowline"><div class="flex between"><strong>${h.year} Presidential Election</strong><span class="tag">${h.result.d>h.result.r?'Democratic victory':h.result.r>h.result.d?'Republican victory':'Tie'}</span></div><div class="muted small">${esc(h.d)} vs. ${esc(h.r)} · D ${h.result.d} EV · R ${h.result.r} EV</div><div class="tiny muted">${fmt(h.result.dv+h.result.rv+h.result.ov)} votes · ${esc(h.date)}</div></div>`).join(''):'<div class="empty">No completed elections. Your universe history will appear here.</div>'}
function renderAll(){let stage=W.election?'Election completed':remaining()+' months to election';$('sidebarClock').textContent=dateLabel();$('sidebarPhase').textContent=stage;$('worldBadge').textContent=W.year+' · Fictional universe';$('pageSubtitle').textContent='The American Electorate · '+dateLabel();renderSettings();renderCandidates();renderDashboard();renderCampaign();renderPolling();renderResults();renderHistory()}
initSelectors();renderAll();
</script></body></html>
